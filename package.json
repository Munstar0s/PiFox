{
  "name": "@munstar0s/pifox",
  "version": "0.1.0",
  "description": "Pi extension: the Camofox anti-detection browser as native agent tools, with lazy lifecycle management",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "camofox",
    "camoufox",
    "browser",
    "pi-agent",
    "pi-coding-agent"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "biome check . && tsc -p tsconfig.json --noEmit",
    "check:format": "biome format .",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run test/",
    "test:e2e": "node test/e2e/real-camofox.mjs",
    "test:harness": "vitest run test/pi-harness.test.ts"
  },
  "dependencies": {
    "@askjo/camofox-browser": "1.14.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Munstar0s/PiFox.git"
  },
  "bugs": {
    "url": "https://github.com/Munstar0s/PiFox/issues"
  },
  "homepage": "https://github.com/Munstar0s/PiFox#readme",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Munstar0s"
  }
}
